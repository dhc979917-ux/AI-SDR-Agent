# Workspace defaults and CLI tools. Employees can override each model in My Models.
# Compatible Chat Completions service. Never commit a real API key.
# Existing DASHSCOPE_API_KEY is also recognized.
SDR_LLM_API_KEY=
SDR_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SDR_LLM_MODEL=qwen-plus

# Local SQLite; defaults to var/sdr.sqlite3.
# SDR_DB_PATH=var/sdr.sqlite3

# Enterprise name resolution. auto uses QCC MCP when credentials are present,
# otherwise it keeps the customer-spoken name. off disables external lookup.
SDR_ENTITY_PROVIDER=auto
QCC_MCP_URL=https://agent.qcc.com/mcp/company/stream
# Prefer this over var/qcc-mcp.json for deployments. Never commit a real token.
QCC_MCP_TOKEN=
# Optional local config fallback; keep the file at 0600 and outside Git.
# QCC_MCP_CONFIG=var/qcc-mcp.json
# QCC_CACHE_PATH=var/qcc-cache.json
# QCC_MCP_TIMEOUT=8
# 默认 0 = 每次都调用企查查 MCP（搜索/详情/重排都不读缓存）。
# 设为 30 可启用 30 天缓存，降低延迟和额度消耗。
# QCC_CACHE_DAYS=30
# QCC_ENRICH_TOP=3

# Legacy local catalog / HTTP adapter. Used only when SDR_ENTITY_PROVIDER=local.
# SDR_ENTITY_API_URL=https://your-authorized-provider.example/api/search
# SDR_ENTITY_API_KEY=
# SDR_ENTITY_CATALOG=/absolute/path/to/verified-entities.json

# Disabled until thresholds and accuracy are validated on representative data.
SDR_AUTO_PUBLISH=false

# Speech recognition; independently configured from the text model.
# Existing DASHSCOPE_API_KEY is also recognized for ASR.
SDR_ASR_API_KEY=
SDR_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SDR_ASR_MODEL=qwen3-asr-flash
# qwen_asr or openai_transcription; must match the ASR URL and model.
SDR_ASR_PROTOCOL=qwen_asr

# Password accounts + HttpOnly session cookies are always required.
# run.sh creates the first administrator if the user database is empty.
# For HTTPS / non-loopback deployments, set true and use an HTTPS reverse proxy.
SDR_COOKIE_SECURE=false

# Online demo bootstrap. Set SDR_SEED_DEMO=true on a fresh persistent volume.
SDR_DEMO_ADMIN_USER=admin
SDR_DEMO_ADMIN_NAME=Demo Admin
# Minimum 12 characters. Prefer a platform secret, not this file.
SDR_DEMO_ADMIN_PASSWORD=
SDR_SEED_DEMO=false
# Behind Render/Fly/Caddy HTTPS, trust forwarded scheme/host for CSRF origin checks.
SDR_PROXY_HEADERS=true
FORWARDED_ALLOW_IPS=*

# VPS + Caddy: public hostname. For an IP without a domain, use sslip.io:
# DEMO_HOST=1-2-3-4.sslip.io
# Or your own domain: DEMO_HOST=demo.example.com
DEMO_HOST=

# Bounded evidence-quality agent for LLM analyses (maximum 3 extra calls).
SDR_QUALITY_AGENT=true
